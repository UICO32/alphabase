{
  "name": "heptabase-canvas-v2",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "vite --mode electron",
    "electron:build": "tsc && vite build --mode electron",
    "electron:start": "electron .",
    "electron:all": "vite --mode electron",
    "electron:pack": "pnpm electron:build && node scripts/electron-pack.mjs --dir",
    "electron:dist": "pnpm electron:build && node scripts/electron-pack.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "playwright test"
  },
  "dependencies": {
    "@blocknote/core": "^0.31.0",
    "@blocknote/mantine": "^0.31.0",
    "@blocknote/react": "^0.31.0",
    "@floating-ui/react": "^0.27.19",
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tiptap/pm": "^2.11.0",
    "@xyflow/react": "^12.0.0",
    "framer-motion": "^12.38.0",
    "idb": "^8.0.0",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.400.0",
    "motion": "^12.39.0",
    "onnxruntime-node": "^1.26.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-icons": "^5.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.0",
    "ts-md5": "^2.0.1",
    "turndown": "^7.2.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "com.heptabase.canvas-v2",
    "productName": "Heptabase Canvas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*",
      "node_modules/sharp/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": true
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "sharp"
    ]
  }
}