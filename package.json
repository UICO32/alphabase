{
  "name": "heptabase-canvas-v2",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "vite --mode electron",
    "electron:build": "node scripts/protect-index.mjs && tsc && vite build --mode electron",
    "electron:start": "node scripts/electron-start.mjs",
    "electron:all": "vite --mode electron",
    "electron:pack": "pnpm electron:build && node scripts/electron-pack.mjs --dir",
    "electron:dist": "pnpm electron:build && node scripts/electron-pack.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@blocknote/core": "^0.31.0",
    "@blocknote/mantine": "^0.31.0",
    "@blocknote/react": "^0.31.0",
    "@floating-ui/react": "^0.27.19",
    "@mozilla/readability": "^0.6.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tiptap/pm": "^2.11.0",
    "@xyflow/react": "^12.0.0",
    "dompurify": "^3.4.7",
    "lucide-react": "^0.400.0",
    "motion": "^12.39.0",
    "onnxruntime-node": "^1.26.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.0",
    "three": "^0.174.0",
    "turndown": "^7.2.4",
    "zustand": "^5.0.0",
    "linkedom": "^0.18.0",
    "ts-md5": "^1.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.174.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-builder-squirrel-windows": "^26.8.1",
    "electron-packager": "^17.1.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^1.6.1"
  },
  "build": {
    "appId": "com.heptabase.canvas-v2",
    "productName": "Heptabase Canvas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*",
      "node_modules/sharp/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "asar": true
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "sharp"
    ]
  }
}
